PORT=3000
NODE_ENV=development

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_here

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Note: Price IDs will need to be configured in your Stripe dashboard
STRIPE_PAIR_MONTHLY_PRICE_ID=price_...
STRIPE_PAIR_YEARLY_PRICE_ID=price_...
STRIPE_PAIR_LIFETIME_PRICE_ID=price_...

STRIPE_TABLE_MONTHLY_PRICE_ID=price_...
STRIPE_TABLE_YEARLY_PRICE_ID=price_...
STRIPE_TABLE_LIFETIME_PRICE_ID=price_...
