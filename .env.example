PORT=3000
NODE_ENV=development

# Public origin, used to build Stripe Checkout return URLs.
# Must be the real origin in production — never derived from request headers.
APP_URL=http://localhost:3000

# Postgres (Neon on Vercel provides this automatically)
DATABASE_URL=postgres://user:password@host/db

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Stripe ---
# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...). This app only needs
# write access to Customers, Checkout Sessions, Billing Portal, and read on Invoices.
# Create one at Dashboard -> Developers -> API keys -> Restricted keys.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Required. Without it every webhook is rejected and no purchase is ever fulfilled.
# Local: `stripe listen --forward-to localhost:3000/api/billing/webhook` prints one.
# Deployed: Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Tax. Leave false until you have an ACTIVE tax registration in at least one
# jurisdiction — with none, Stripe silently calculates zero tax while appearing on.
# See README "Stripe Tax" before setting this to true.
STRIPE_TAX_ENABLED=false

# Price IDs (names must match exactly: STRIPE_<TIER>_<CYCLE>)
STRIPE_PAIR_MONTHLY=price_...
STRIPE_PAIR_YEARLY=price_...
STRIPE_PAIR_LIFETIME=price_...

STRIPE_TABLE_MONTHLY=price_...
STRIPE_TABLE_YEARLY=price_...
STRIPE_TABLE_LIFETIME=price_...
